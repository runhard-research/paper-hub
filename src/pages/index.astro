---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperCard from '../components/PaperCard.astro';
import { papers, recentPapers, years } from '../lib/papers';
import { categories } from '../lib/taxonomy';
const categoryCounts = new Map<string, number>();
for (const paper of papers) for (const id of paper.classification.categories ?? []) categoryCounts.set(id, (categoryCounts.get(id) ?? 0) + 1);
---
<BaseLayout title="Paper Hub">
  <section>
    <p class="muted">Research paper library</p>
    <h1>Find the thread through your reading.</h1>
    <div class="grid">
      <div class="stat"><strong>{papers.length}</strong>papers</div>
      <div class="stat"><strong>{categories.length}</strong>categories</div>
      <div class="stat"><strong>{years.length}</strong>year folders</div>
    </div>
  </section>

  <section>
    <h2>Categories</h2>
    <div class="grid">
      {categories.map((category) => <a class="card" href={`/categories/${category.id}/`}><strong>{category.name}</strong><br /><span class="muted">{categoryCounts.get(category.id) ?? 0} papers</span></a>)}
    </div>
  </section>

  <section>
    <h2>Year folders</h2>
    <p>{years.map((year) => <a class="pill" href={`/years/${year}/`}>{year}</a>)}</p>
  </section>

  <section>
    <h2>Recent papers</h2>
    {recentPapers.slice(0, 12).map((paper) => <PaperCard paper={paper} />)}
  </section>

  <section id="search">
    <h2>Search the library</h2>
    <p class="muted">Searches titles, authors, tags, categories, tasks, technologies, and applications.</p>
    <input id="paper-search" type="search" placeholder="e.g. gaussian splatting, robotics, transformer" autocomplete="off" />
    <p id="search-count" class="muted">{papers.length} papers</p>
    <div id="search-results">{recentPapers.map((paper) => <PaperCard paper={paper} />)}</div>
  </section>
</BaseLayout>
<script>
  const input = document.querySelector<HTMLInputElement>('#paper-search');
  const cards = [...document.querySelectorAll<HTMLElement>('#search-results .paper-card')];
  const count = document.querySelector('#search-count');
  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const matches = !query || (card.dataset.search ?? '').includes(query);
      card.classList.toggle('hidden', !matches);
      if (matches) visible += 1;
    }
    if (count) count.textContent = `${visible} paper${visible === 1 ? '' : 's'}`;
  });
</script>
